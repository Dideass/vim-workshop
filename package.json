{
  "name": "vim-workshop",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/vendor.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/vendor.mjs",
    "build": "tsc -b && vite build",
    "prepare:vim": "node scripts/vendor.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "test:practice": "node scripts/practice-check.mjs",
    "test:course": "node scripts/course-check.mjs",
    "test:isolation": "node scripts/isolation-check.mjs",
    "test:resilience": "node scripts/resilience-check.mjs",
    "test:i18n": "node scripts/i18n-check.mjs",
    "test:hints": "node scripts/hints-check.mjs",
    "test:spaces": "node scripts/spaces-check.mjs",
    "test:sentences": "node scripts/sentences-check.mjs",
    "test:completion": "node scripts/completion-check.mjs",
    "test:migration": "node scripts/migration-check.mjs",
    "test:native": "node scripts/native-check.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "coi-serviceworker": "0.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vim-wasm": "0.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
